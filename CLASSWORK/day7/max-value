'''Problem:
After reading each element, print the maximum value seen so far.

Input:
5 3 9 2 7

output:
[5, 5, 9, 9, 9]
'''

def max_ele(arr):
  max=arr[0]
  for i in range(len(arr)):
    if arr[i]>max:
      max=arr[i]
    else:
      arr[i]=max
  return arr

arr=list(map(int,input().split()))
print(max_ele(arr))