"""
The time complexity is O(n) because we visit half of the array
 and the space complexity is O(1)
 """



class Solution:
    def reverseArray(self,arr):
        left = 0
        right = len(arr) - 1
        while left < right:
           arr[left], arr[right] = arr[right], arr[left]
           left += 1
           right -= 1
        return arr
        