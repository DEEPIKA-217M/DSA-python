"""
Left rotation using reverse algorithm
"""
def rotateArr(arr, d):
    n = len(arr)
    d = d % n

    result = []

    for i in range(d, n):
        result.append(arr[i])

    for i in range(d):
        result.append(arr[i])

    return result


arr = list(map(int, input().split()))

print(rotateArr(arr, 2))