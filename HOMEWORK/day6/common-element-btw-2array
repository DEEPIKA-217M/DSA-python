class Solution(object):
    def findIntersectionValues(self, nums1, nums2):
        s1 = set(nums1)
        s2 = set(nums2)

        a1 = 0
        a2 = 0

        for i in nums1:
            if i in s2:
                a1 += 1

        for i in nums2:
            if i in s1:
                a2 += 1

        return [a1, a2]